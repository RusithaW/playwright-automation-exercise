{
  "name": "playwright-automation-exercise",
  "version": "1.0.0",
  "description": "Automated UI and API testing framework for AutomationExercise.com built using Playwright and TypeScript.",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --project=chromium-ui",
    "test:api": "npx playwright test --project=api",
    "test:all": "npx playwright test",
    "test:chromium": "npx playwright test --project=chromium-ui",
    "test:headed": "npx playwright test --headed",
    "report": "npx playwright show-report",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation-exercise",
    "test-automation",
    "e2e-testing",
    "api-testing"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.0.0",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "fsevents@2.3.2": true
  }
}
